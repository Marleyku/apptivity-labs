{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apptivity-labs",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
