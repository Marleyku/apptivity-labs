# PostHog (browser) — empty disables
VITE_POSTHOG_PROJECT_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_CAPTURE_ENABLED=true

# Sentry (browser) — empty disables
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Admin Basic Auth for /admin* — ALWAYS single-quote values so # $ " ! ` stay literal:
#   ADMIN_USERNAME='marley'
#   ADMIN_PASSWORD='p@ss#word$'
# Or base64 (any characters): ADMIN_PASSWORD_B64='...'
# Sync to production Worker secrets: npm run secrets:admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_PASSWORD_B64=
